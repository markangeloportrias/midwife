# On an IPv4-only network, copy the "Session pooler" URL from
# Supabase Dashboard > Connect. Keep the real password only in .env.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
PORT=3000
SESSION_HOURS=12
ALLOWED_ORIGIN=

# Optional: used only if the database has no administrator yet.
# INITIAL_ADMIN_PIN=
